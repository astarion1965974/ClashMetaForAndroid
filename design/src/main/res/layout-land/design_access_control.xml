<?xml version='1.0' encoding='utf-8'?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data><variable name="self" type="com.github.kr328.clash.design.AccessControlDesign"/></data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="@{self.surface.insets.start}" android:paddingEnd="@{self.surface.insets.end}" android:paddingBottom="@{self.surface.insets.bottom}">
        <com.github.kr328.clash.design.view.ActivityBarLayout android:id="@+id/activity_bar_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@{self.surface.insets.top}">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <include layout="@layout/common_activity_bar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/toolbar_height"/>
                <ImageView android:id="@+id/menu_view" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_baseline_more_vert" android:contentDescription="@string/more" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
        </com.github.kr328.clash.design.view.ActivityBarLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"><ScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:text="@string/live_app_intro" android:textAppearance="@style/TextAppearance.Live.Heading"/>
            <androidx.compose.ui.platform.ComposeView android:id="@+id/controls_view" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        </ScrollView><FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/main_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="8dp"/>
            <TextView android:id="@+id/empty_view" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="24dp" android:text="@string/app_loading" android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"/>
        </FrameLayout>
        </LinearLayout><com.github.kr328.clash.design.view.CouiButtonView android:id="@+id/save_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginHorizontal="20dp" android:layout_marginVertical="8dp" android:text="@string/route_save"/>
    </LinearLayout>
</layout>
