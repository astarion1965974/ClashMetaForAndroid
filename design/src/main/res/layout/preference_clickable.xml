<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_live_row"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="4dp"
        android:paddingStart="16dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/item_min_height"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/item_padding_vertical"
        android:paddingEnd="@dimen/item_tailing_margin">

        <View
            android:id="@+id/icon_view"
            android:layout_width="24dp"
            android:layout_height="@dimen/item_header_component_size"
            android:layout_marginStart="0dp" android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Live.Body" />

            <TextView
                android:id="@+id/summary_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_text_margin"
                android:textAppearance="@style/TextAppearance.Live.Secondary" />
        </LinearLayout>
    </LinearLayout>
</layout>