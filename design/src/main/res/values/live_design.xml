<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="colorLiveBorder" format="color" />
    <attr name="colorLiveMuted" format="color" />
    <attr name="colorLiveRaised" format="color" />
    <attr name="colorLiveSelection" format="color" />
    <attr name="colorLiveSuccess" format="color" />

    <style name="TextAppearance.Live.Title" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.Live.Heading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="TextAppearance.Live.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.Live.Secondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorLiveMuted</item>
    </style>
    <style name="TextAppearance.Live.Section" parent="TextAppearance.Live.Secondary">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.025</item>
    </style>
    <style name="Widget.Live.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">17dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Widget.Live.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/live_input_stroke</item>
    </style>
</resources>
