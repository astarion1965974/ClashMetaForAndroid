<?xml version="1.0" encoding="utf-8"?>
<!-- ColorOS 17 subpage: short spatial advance, rounded translucent surface.
     Do not override the close transition: the platform owns predictive back. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="true"
    android:interpolator="@android:interpolator/decelerate_quad">
    <translate
        android:fromXDelta="20%p"
        android:toXDelta="0%p"
        android:duration="340"/>
    <scale
        android:fromXScale="0.975"
        android:fromYScale="0.985"
        android:toXScale="1.0"
        android:toYScale="1.0"
        android:pivotX="100%"
        android:pivotY="50%"
        android:duration="340"/>
    <alpha
        android:fromAlpha="0.96"
        android:toAlpha="1.0"
        android:duration="260"/>
</set>
